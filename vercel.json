{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/tarifs", "destination": "/prestations", "permanent": true },
    { "source": "/tarifs/mariage", "destination": "/prestations/mariage", "permanent": true },
    { "source": "/tarifs/grossesse", "destination": "/prestations/grossesse", "permanent": true },
    { "source": "/tarifs/naissance", "destination": "/prestations/naissance", "permanent": true },
    { "source": "/politque-de-confidentialite", "destination": "/politique-de-confidentialite", "permanent": true },
    { "source": "/assets/picture/portfolio-naissance/portfolio-naissance-22.avif", "destination": "/portfolio/naissance", "permanent": true }
  ],
  "rewrites": [
    { "source": "/assets/picture/portfolio-:univers(mariage|grossesse|naissance)/:fichier", "destination": "/portfolio/:univers" }
  ]
}
